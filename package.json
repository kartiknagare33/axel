{
  "name": "axel",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "db:up": "docker compose up -d db",
    "migrate": "pnpm --filter @axel/api migrate",
    "seed": "pnpm --filter @axel/api seed",
    "dev:api": "pnpm --filter @axel/api dev",
    "dev:web": "pnpm --filter @axel/web dev",
    "test:isolation": "pnpm --filter @axel/api test:isolation",
    "test:workflow": "pnpm --filter @axel/api test:workflow",
    "test:excel": "pnpm --filter @axel/api test:excel",
    "test:api": "pnpm --filter @axel/api test:api",
    "docs": "pnpm --filter @axel/api docs",
    "test:gate": "pnpm --filter @axel/api test:gate",
    "test:replay": "pnpm --filter @axel/api test:replay",
    "test": "pnpm test:isolation && pnpm test:workflow && pnpm test:excel && pnpm test:api && pnpm test:gate && pnpm test:replay"
  }
}
